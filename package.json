{
  "name": "@feedbay/mcp-server",
  "version": "0.4.1",
  "type": "module",
  "description": "FeedBay MCP server: build, style, publish and analyse FeedBay surveys from Claude, ChatGPT, Cursor or any MCP client",
  "license": "MIT",
  "author": "FeedBay (https://feedbay.io)",
  "homepage": "https://github.com/sanke46/feedbay-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanke46/feedbay-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sanke46/feedbay-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "feedbay",
    "surveys",
    "nps",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "bin": {
    "feedbay-mcp": "./dist/bin/stdio.js",
    "feedbay-mcp-http": "./dist/bin/http.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/bin/stdio.ts",
    "dev:http": "tsx src/bin/http.ts",
    "smoke": "tsx scripts/smoke.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "pack:mcpb": "node scripts/pack-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
